# Document Processor Service — environment configuration
#
# Copy this file to `.env` and fill in the values marked REQUIRED.
# `.env` is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# MinIO object storage
# ---------------------------------------------------------------------------
#
# Every upload is stored in this bucket, read back out of it for parsing, and the
# extraction output is written back next to it. The response carries a presigned
# download link for that output.

# REQUIRED. host:port of the MinIO server (a full http:// or https:// URL also works,
# in which case the scheme sets MINIO_SECURE).
MINIO_ENDPOINT=localhost:9000

# REQUIRED. MinIO credentials.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Bucket for sources and output. Created on startup if it does not exist.
MINIO_BUCKET=documents

# true when MinIO is served over TLS.
MINIO_SECURE=false

# Region used when signing. MinIO reports us-east-1 unless its own MINIO_REGION says
# otherwise; it is pinned here because looking it up costs a network call the presigning
# client cannot always make.
MINIO_REGION=us-east-1

# Host to put in the returned download link when it differs from the one the service
# dials -- e.g. the API reaches MinIO at `minio:9000` inside Docker, while your browser
# needs `localhost:9000`. Leave empty to use MINIO_ENDPOINT as-is.
MINIO_PUBLIC_ENDPOINT=

# Lifetime of the presigned download URL, in seconds. 604800 (7 days) is the maximum.
MINIO_URL_EXPIRY_SECONDS=604800

# Key prefixes inside the bucket.
MINIO_SOURCE_PREFIX=sources
MINIO_OUTPUT_PREFIX=extracted

# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------

# Delete the uploaded source as soon as its extracted text has been stored. The output and
# its download link are unaffected. Keeping the source (the default) is what lets you re-run
# an extraction without the caller uploading the file again.
MINIO_DELETE_SOURCE_AFTER_EXTRACT=false

# Expire objects under each prefix after this many days; 0 keeps them forever.
# Enforced by MinIO's own lifecycle scanner, not by this service -- so it keeps working while
# the service is down, and it never breaks a download link that is still inside its window.
# Applied to the bucket on startup; rules the service did not write are left alone.
MINIO_SOURCE_RETENTION_DAYS=0
MINIO_OUTPUT_RETENTION_DAYS=0

# Uploads larger than this are rejected with 413 before anything is stored.
MAX_UPLOAD_SIZE_BYTES=26214400

# ---------------------------------------------------------------------------
# Document extraction
# ---------------------------------------------------------------------------

# Max number of documents parsed concurrently by the /extract endpoint.
DOCUMENT_EXTRACTION_WORKERS=2

# OCR settings, used for scanned/image-based PDFs.
DOCUMENT_OCR_DPI=200
DOCUMENT_OCR_MAX_PAGES=50
DOCUMENT_OCR_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# OpenAI text correction (post_processing=clean / post_processing=markdown)
# ---------------------------------------------------------------------------

# REQUIRED for post_processing=clean or post_processing=markdown.
# Get this from https://platform.openai.com/api-keys — keep it secret.
OPENAI_API_KEY=

# Chat Completions model used for spelling/grammar correction and markdown formatting.
OPENAI_MODEL=gpt-4.1

# Caps each correction request's output tokens, and also sets the chunking
# thresholds: documents over MAX_TOKENS are split into parallel chunks;
# documents over 10x MAX_TOKENS skip correction entirely (see README).
MAX_TOKENS=32768

# Number of chunks corrected concurrently for large documents.
DOCUMENT_CORRECTION_CHUNK_PARALLELISM=10

# Per-chunk input budget in tokens. Text above this size is split into chunks of at most this
# size, corrected in parallel, and joined back together.
#
# Do not raise this to the model's output cap. Measured on real Diavgeia/FEK text with gpt-4.1,
# sizes up to 12000 reproduced every sampled region in full, while 14000 and above intermittently
# stopped a third of the way through -- with finish_reason still "stop" and no placeholder text,
# so the loss is silent. 8000 keeps a safety margin under that threshold.
DOCUMENT_CHUNK_TOKENS=8000
