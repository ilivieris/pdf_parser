# Document Processor Service — environment configuration
#
# Copy this file to `.env` and fill in the values marked REQUIRED.
# `.env` is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Local storage
# ---------------------------------------------------------------------------

# Base directory where extraction output (raw/clean/markdown) is written.
# Relative paths are resolved against the process working directory
# (inside the Docker image, that's /app).
DOCUMENT_OUTPUT_ROOT=./extracted

# ---------------------------------------------------------------------------
# Document extraction
# ---------------------------------------------------------------------------

# Max number of documents parsed concurrently by the /extract endpoint.
DOCUMENT_EXTRACTION_WORKERS=2

# OCR settings, used for scanned/image-based PDFs.
DOCUMENT_OCR_DPI=200
DOCUMENT_OCR_MAX_PAGES=50
DOCUMENT_OCR_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# OpenAI text correction (post_processing=clean / post_processing=markdown)
# ---------------------------------------------------------------------------

# REQUIRED for post_processing=clean or post_processing=markdown.
# Get this from https://platform.openai.com/api-keys — keep it secret.
OPENAI_API_KEY=

# Chat Completions model used for spelling/grammar correction and markdown formatting.
OPENAI_MODEL=gpt-4.1

# Caps each correction request's output tokens, and also sets the chunking
# thresholds: documents over MAX_TOKENS are split into parallel chunks;
# documents over 10x MAX_TOKENS skip correction entirely (see README).
MAX_TOKENS=32768

# Number of chunks corrected concurrently for large documents.
DOCUMENT_CORRECTION_CHUNK_PARALLELISM=10

# Per-chunk input budget in tokens. Text above this size is split into chunks of at most this
# size, corrected in parallel, and joined back together.
#
# Do not raise this to the model's output cap. Measured on real Diavgeia/FEK text with gpt-4.1,
# sizes up to 12000 reproduced every sampled region in full, while 14000 and above intermittently
# stopped a third of the way through -- with finish_reason still "stop" and no placeholder text,
# so the loss is silent. 8000 keeps a safety margin under that threshold.
DOCUMENT_CHUNK_TOKENS=8000
